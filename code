# 4. ELO RATINGS — pre-gameweek freeze
#    On days with multiple matches, all games see the same
#    pre-day ELO (updates are buffered and applied next day).
# ═══════════════════════════════════════════════════════════════
def compute_elo_ratings(df, result_col='FullTimeResult', home_col='HomeTeam',
                         away_col='AwayTeam', date_col='MatchDate',
                         k=32, home_advantage=100, initial_elo=1500):
    elo = {}
    home_elo_list, away_elo_list = [], []
    current_date  = None
    daily_updates = {}

    for _, row in df.iterrows():
        home, away, result = row[home_col], row[away_col], row[result_col]
        date = row[date_col]

        if date != current_date:
            for team, new_rating in daily_updates.items():
                elo[team] = new_rating
            daily_updates = {}
            current_date  = date

        he = elo.get(home, initial_elo)
        ae = elo.get(away, initial_elo)
        home_elo_list.append(he)
        away_elo_list.append(ae)

        exp_h    = 1 / (1 + 10 ** ((ae - (he + home_advantage)) / 400))
        actual_h = 1 if result == 'H' else (0 if result == 'A' else 0.5)
        actual_a = 1 - actual_h

        daily_updates[home] = elo.get(home, initial_elo) + k * (actual_h - exp_h)
        daily_updates[away] = elo.get(away, initial_elo) + k * (actual_a - (1 - exp_h))

    for team, new_rating in daily_updates.items():
        elo[team] = new_rating

    df['HomeElo'] = home_elo_list
    df['AwayElo'] = away_elo_list
    df['EloDiff'] = df['HomeElo'] - df['AwayElo']
    return df, elo

