# 2. ROLLING PRE-MATCH STATS
#    Each team's avg from last 5 games BEFORE this match.
#    Replaces raw post-match shot/corner/foul values.
# ═══════════════════════════════════════════════════════════════
def compute_rolling_stats(df, home_col='HomeTeam', away_col='AwayTeam', window=5):
    defaults = {'shots': 12.0, 'sot': 4.5, 'corners': 5.0, 'fouls': 12.0}
    team_stats = {}
    cols = {c: [] for c in ['HomeShots', 'AwayShots', 'HomeShotsOnTarget',
                             'AwayShotsOnTarget', 'HomeCorners', 'AwayCorners',
                             'HomeFouls', 'AwayFouls']}

    def avg(team, key):
        h = team_stats.get(team, {}).get(key, [])
        return np.mean(h[-window:]) if h else defaults[key]

    for _, row in df.iterrows():
        home, away = row[home_col], row[away_col]
        cols['HomeShots'].append(avg(home, 'shots'))
        cols['AwayShots'].append(avg(away, 'shots'))
        cols['HomeShotsOnTarget'].append(avg(home, 'sot'))
        cols['AwayShotsOnTarget'].append(avg(away, 'sot'))
        cols['HomeCorners'].append(avg(home, 'corners'))
        cols['AwayCorners'].append(avg(away, 'corners'))
        cols['HomeFouls'].append(avg(home, 'fouls'))
        cols['AwayFouls'].append(avg(away, 'fouls'))

        for team, s, so, c, f in [
            (home, row['HomeShots'], row['HomeShotsOnTarget'],
             row['HomeCorners'], row['HomeFouls']),
            (away, row['AwayShots'], row['AwayShotsOnTarget'],
             row['AwayCorners'], row['AwayFouls'])
        ]:
            team_stats.setdefault(team, {'shots': [], 'sot': [], 'corners': [], 'fouls': []})
            team_stats[team]['shots'].append(s)
            team_stats[team]['sot'].append(so)
            team_stats[team]['corners'].append(c)
            team_stats[team]['fouls'].append(f)

    for col, vals in cols.items():
        df[col] = vals
    return df, team_stats

# ═══════════════════════════════════════════════════════════════
# 3. TEAM FORM  (rolling points over last 5 games)
# ═══════════════════════════════════════════════════════════════
def compute_team_form(df, result_col='FullTimeResult', home_col='HomeTeam',
                      away_col='AwayTeam', window=5):
    home_pts = {'H': 3, 'D': 1, 'A': 0}
    away_pts = {'H': 0, 'D': 1, 'A': 3}
    team_form = {}
    home_form_list, away_form_list = [], []

    for _, row in df.iterrows():
        home, away, result = row[home_col], row[away_col], row[result_col]
        hh = team_form.get(home, [])
        ah = team_form.get(away, [])
        home_form_list.append(np.mean(hh[-window:]) if hh else 1.0)
        away_form_list.append(np.mean(ah[-window:]) if ah else 1.0)
        team_form.setdefault(home, []).append(home_pts.get(result, 1))
        team_form.setdefault(away, []).append(away_pts.get(result, 1))

    df['HomeForm'] = home_form_list
    df['AwayForm']  = away_form_list
    return df, team_form

