# 12. HELPER FUNCTIONS FOR UNSEEN DATA PREDICTOR
# ═══════════════════════════════════════════════════════════════
INITIAL_ELO = 1500
WINDOW      = 5

def get_form(team, form_history):
    h = form_history.get(team, [])
    return np.mean(h[-WINDOW:]) if h else 1.0

def get_elo(team, elo_dict):
    return elo_dict.get(team, INITIAL_ELO)

def get_stat(team, key, stats_history):
    defaults = {'shots': 12.0, 'sot': 4.5, 'corners': 5.0, 'fouls': 12.0}
    h = stats_history.get(team, {}).get(key, [])
    return np.mean(h[-WINDOW:]) if h else defaults[key]

def build_feature_vector(home_team, away_team,
                          form_history, elo_dict, stats_history,
                          home_shots=None, away_shots=None,
                          home_sot=None, away_sot=None,
                          home_corners=None, away_corners=None,
                          home_fouls=None, away_fouls=None):
    """
    Build feature vector for a fixture.
    If manual stats are provided they override the rolling averages.
    """
    he       = get_elo(home_team, elo_dict)
    ae       = get_elo(away_team, elo_dict)
    elo_diff = he - ae

    vec = np.array([[
        home_shots   if home_shots   is not None else get_stat(home_team, 'shots',   stats_history),
        away_shots   if away_shots   is not None else get_stat(away_team, 'shots',   stats_history),
        home_sot     if home_sot     is not None else get_stat(home_team, 'sot',     stats_history),
        away_sot     if away_sot     is not None else get_stat(away_team, 'sot',     stats_history),
        home_corners if home_corners is not None else get_stat(home_team, 'corners', stats_history),
        away_corners if away_corners is not None else get_stat(away_team, 'corners', stats_history),
        home_fouls   if home_fouls   is not None else get_stat(home_team, 'fouls',   stats_history),
        away_fouls   if away_fouls   is not None else get_stat(away_team, 'fouls',   stats_history),
        get_form(home_team, form_history),
        get_form(away_team, form_history),
        he, elo_diff
    ]])
    return vec, he, ae

def run_prediction(home_team, away_team, feature_vec, he, ae,
                   model, scaler, label_encoder, form_history):
    scaled     = scaler.transform(feature_vec)
    pred_enc   = model.predict(scaled)[0]
    pred_proba = model.predict_proba(scaled)[0]
    pred_label = label_encoder.inverse_transform([pred_enc])[0]
    proba_dict = {cls: prob for cls, prob in zip(label_encoder.classes_, pred_proba)}

    emoji = {'H': '🏠', 'D': '🤝', 'A': '✈️'}.get(pred_label, '❓')
    label = {'H': 'Home Win', 'D': 'Draw', 'A': 'Away Win'}.get(pred_label, pred_label)

    print(f"\n  Prediction     : {emoji}  {label}")
    print(f"  Confidence     : Away={proba_dict.get('A',0):.1%}  "
          f"Draw={proba_dict.get('D',0):.1%}  Home={proba_dict.get('H',0):.1%}")
    print(f"  ELO            : {home_team}={he:.0f}  {away_team}={ae:.0f}  Diff={he-ae:+.0f}")
    print(f"  Form (avg pts) : {home_team}={get_form(home_team, form_history):.2f}  "
          f"{away_team}={get_form(away_team, form_history):.2f}")

